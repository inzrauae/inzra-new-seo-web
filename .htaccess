Options -MultiViews
DirectoryIndex index.html

# Reverse-proxy /admin/* to the Laravel backend.
# Requires mod_proxy + mod_proxy_http on the server.
<IfModule mod_proxy.c>
    ProxyPassReverse /admin https://api.inzra.com/admin
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On

# Canonical host.
RewriteCond %{HTTP_HOST} ^www\.inzra\.com$ [NC]
RewriteRule ^ https://inzra.com%{REQUEST_URI} [R=301,L]

# Forward /admin/* transparently to the Laravel backend.
RewriteCond %{REQUEST_URI} ^/admin(/|$)
RewriteRule ^admin(/.*)?$ https://api.inzra.com/admin$1 [P,L]

# Keep the homepage canonical.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]|$) [NC]
RewriteRule ^index\.html$ / [R=301,L]

RewriteRule ^index/?$ / [R=301,L]

# Redirect direct .html requests to extensionless URLs.
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html(?:[?\s]|$) [NC]
RewriteRule ^ /%1 [R=301,L]

# /products must map to products.html, even though /products/ is a real directory.
RewriteRule ^products/?$ products.html [L]

# Serve existing .html files for extensionless requests.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>